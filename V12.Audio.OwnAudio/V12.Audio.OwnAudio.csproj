<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>V12.Audio.OwnAudio</AssemblyName>
    <RootNamespace>V12.Audio.OwnAudio</RootNamespace>
    <PackageId>Finite.V12.Audio.OwnAudio</PackageId>
    <Version>1.0.0</Version>
    <Authors>Charlie-san; Finite</Authors>
    <Description>OwnAudioSharp backend for the V12.Audio contract.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(V12AudioProject)" />
    <PackageReference Include="OwnAudioSharp" Version="4.0.12" />
  </ItemGroup>

</Project>
