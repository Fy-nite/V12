    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <AssemblyName>V12.Audio</AssemblyName>
    <RootNamespace>V12.Audio</RootNamespace>
    <PackageId>Finite.V12.Audio</PackageId>
