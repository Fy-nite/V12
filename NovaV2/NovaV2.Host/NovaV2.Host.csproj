<Project Sdk="Godot.NET.Sdk/4.8.0-beta.3">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NovaV2.Host</RootNamespace>
    <AssemblyName>NovaV2.Host</AssemblyName>
    <!-- <EnableDynamicLoading>true</EnableDynamicLoading> -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaV2.Shared\NovaV2.Shared.csproj" />
    <ProjectReference Include="$(V12HostProject)" />
    <ProjectReference Include="$(V12EngineProject)" />
    <ProjectReference Include="$(V12BasicProject)" />
    <ProjectReference Include="$(V12BindingsProject)" />
    <!-- Gamepaks use these through Basic; direct references keep the host
         output (and exported builds) carrying the DLLs the gamepak loader
         needs to resolve at runtime. -->
    <ProjectReference Include="$(V12PhysicsProject)" />
    <ProjectReference Include="$(V12GravityProject)" />
    <ProjectReference Include="$(V12VoxelProject)" />
  </ItemGroup>

</Project>
