  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <ProjectReference Include="$(V12EngineProject)" />
    <InternalsVisibleTo Include="V12.Architecture.Tests" />
  </ItemGroup>

</Project>
