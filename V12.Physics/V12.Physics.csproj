<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Finite.V12.Physics</PackageId>
    <Version>1.0.0</Version>
    <Authors>Charlie-san; Finite</Authors>
    <Description>Bepu-backed physics backend, body extensions, inertia and fixed-step integration for V12</Description>
