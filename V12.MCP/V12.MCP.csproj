<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stdio MCP server for V12. It talks to the in-game probe over loopback HTTP
    and never references V12-Engine: the probe owns the live tree, this project
    only shapes it into MCP tools. Launched by the MCP client, not by the game.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>V12.MCP</AssemblyName>
    <RootNamespace>V12.MCP</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

</Project>
